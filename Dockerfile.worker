FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime
WORKDIR /app
COPY requirements.txt .
RUN grep -v -E '^(torch|torchvision)' requirements.txt > r.txt && pip install --no-cache-dir -r r.txt && pip install --no-cache-dir torchvision
COPY . .
ENV RLNAS_EVALUATOR=torch
CMD ["python", "-m", "experiments.run", "--config", "configs/default.yaml"]
